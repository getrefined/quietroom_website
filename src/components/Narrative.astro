---
/**
 * `narrative` slice: long-form copy in one of four layouts.
 *  - prose: narrow centred column
 *  - image-right / image-left: text (3fr) beside an image (2fr) that sticks below the nav on
 *    desktop; a single column with the image after the text on mobile
 *  - two-column: the body flows in two CSS columns from 1024px
 * `background` 'grey' → .section--alt. The body may contain h3s, lists and links.
 * Fields (primary): eyebrow, heading, body, image, layout, background.
 */
import { richText, plainText, imageSrc } from '../lib/site';

interface Props {
  slice?: any;
  index?: number;
  settings?: any;
}

const { slice } = Astro.props;

/** Used only when an image layout is chosen but no image has been uploaded. */
const FALLBACK_IMAGE = {
  url: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=70',
  alt: 'A calm, light room with plants beside a window',
  dimensions: { width: 1200, height: 800 },
};

const fallback = {
  eyebrow: 'Take the first step',
  heading: [{ type: 'heading2', text: 'A quiet space to talk', spans: [] }],
  body: [
    {
      type: 'paragraph',
      text: 'Psychotherapy and counselling offer an open, quiet space in which to explore your feelings, thoughts and experiences without the baggage of assumption.',
      spans: [],
    },
  ],
  image: null,
  layout: 'prose',
  background: 'white',
};

const p = slice?.primary ?? fallback;
/** StructuredText → HTML, but '' for an empty field or a lone empty paragraph. */
const rich = (field: any) => (plainText(field).trim() ? richText(field) : '');

const eyebrow: string = (p.eyebrow ?? '').trim();
const heading = rich(p.heading);
const body = rich(p.body);
const showHead = Boolean(eyebrow || heading);
const grey = p.background === 'grey';

const requested: string = p.layout || 'prose';
const isImage = requested === 'image-right' || requested === 'image-left';
const layout = isImage || requested === 'two-column' ? requested : 'prose';

const image = isImage ? (p.image?.url ? p.image : FALLBACK_IMAGE) : null;
const imgSrc = image ? imageSrc(image) : undefined;
const imgAlt: string = image?.alt ?? '';
const imgWidth = image?.dimensions?.width;
const imgHeight = image?.dimensions?.height;
---

<section class:list={['section', 'narrative', `narrative--${layout}`, { 'section--alt': grey }]}>
  <div class={layout === 'prose' ? 'container--narrow' : 'container'}>
    {isImage ? (
      <div class="narrative__grid">
        <div class="narrative__text reveal">
          {showHead && (
            <div class="narrative__head">
              {eyebrow && <span class="eyebrow">{eyebrow}</span>}
              {heading && <Fragment set:html={heading} />}
            </div>
          )}
          {body && <div class="prose narrative__body" set:html={body} />}
        </div>
        <div class="narrative__media reveal reveal-delay-1">
          <img
            src={imgSrc}
            alt={imgAlt}
            width={imgWidth}
            height={imgHeight}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    ) : (
      <Fragment>
        {showHead && (
          <div class="narrative__head reveal">
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            {heading && <Fragment set:html={heading} />}
          </div>
        )}
        {body && (
          <div
            class:list={[
              'prose',
              'narrative__body',
              'reveal',
              { 'narrative__body--columns': layout === 'two-column' },
            ]}
            set:html={body}
          />
        )}
      </Fragment>
    )}
  </div>
</section>

<style>
  .narrative__head {
    max-width: 44rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* The h2 is injected via set:html; the wrapper owns the spacing below it. */
  .narrative__head :global(h2) {
    margin-bottom: 0;
  }

  /* Body copy tweaks on top of the global .prose rules. */
  .narrative__body :global(h3) {
    margin-top: 1.6em;
    margin-bottom: 0.5em;
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.375rem);
  }

  .narrative__body :global(ul),
  .narrative__body :global(ol) {
    margin-bottom: 1.25em;
  }

  .narrative__body :global(a) {
    font-weight: 500;
  }

  /* Image layouts */
  .narrative__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .narrative__text {
    min-width: 0;
  }

  .narrative__media {
    align-self: start;
  }

  .narrative__media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  @media (min-width: 768px) {
    .narrative__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .narrative--image-left .narrative__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }

    /* DOM order stays text-then-image (mobile); the image moves first only on wide screens. */
    .narrative--image-left .narrative__media {
      order: -1;
    }
  }

  @media (min-width: 1024px) {
    /* align-self: start above keeps the sticky item shorter than its grid area. */
    .narrative__media {
      position: sticky;
      top: calc(var(--nav-height) + 2rem);
    }

    /* Two-column layout */
    .narrative__body--columns {
      columns: 2;
      column-gap: 3rem;
    }

    .narrative__body--columns :global(h3) {
      break-inside: avoid;
      break-after: avoid;
    }

    .narrative__body--columns :global(li) {
      break-inside: avoid;
    }

    .narrative__body--columns :global(p) {
      orphans: 3;
      widows: 3;
    }
  }
</style>

---
/**
 * `accreditations` slice: a compact strip with a small heading, one line of text and the
 * accreditation marks on white chips with their names beneath. A chip is wrapped in a link
 * only when its link resolves. Falls back to `settings.accreditations` when the slice has no
 * items. Fields (primary): heading (Text), text, items[{ logo, name, link }].
 */
import { richText, plainText, imageSrc, resolveLink, isExternal } from '../lib/site';

interface Props {
  slice?: any;
  index?: number;
  settings?: any;
}

const { slice, settings } = Astro.props;

const p = slice?.primary ?? {};
/** StructuredText → HTML, but '' for an empty field or a lone empty paragraph. */
const rich = (field: any) => (plainText(field).trim() ? richText(field) : '');

const heading = plainText(p.heading).trim() || 'Registered and accredited';
const text = rich(p.text);

const source: any[] =
  Array.isArray(p.items) && p.items.length > 0
    ? p.items
    : Array.isArray(settings?.accreditations)
      ? settings.accreditations
      : [];

const items = source
  .map((item: any) => {
    const name: string = (item.name ?? '').trim();
    const url = resolveLink(item.link);
    return {
      src: imageSrc(item.logo),
      alt: item.logo?.alt || name,
      width: item.logo?.dimensions?.width,
      height: item.logo?.dimensions?.height,
      name,
      url,
      external: isExternal(url),
    };
  })
  .filter((item) => item.src || item.name);
---

<section class="section section--sm accreditations">
  <div class="container accreditations__inner">
    <div class="accreditations__intro reveal">
      <h2 class="accreditations__heading">{heading}</h2>
      {text && <div class="prose prose--muted accreditations__text" set:html={text} />}
    </div>

    {items.length > 0 && (
      <ul class="accreditations__list reveal reveal-delay-1" role="list">
        {items.map((item) => (
          <li class="accreditation">
            {item.url ? (
              <a
                class="accreditation__link"
                href={item.url}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                <span class="logo-chip">
                  {item.src ? (
                    <img
                      src={item.src}
                      alt={item.alt}
                      width={item.width}
                      height={item.height}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="accreditation__text-mark">{item.name}</span>
                  )}
                </span>
                {item.name && <span class="accreditation__name">{item.name}</span>}
              </a>
            ) : (
              <Fragment>
                <span class="logo-chip">
                  {item.src ? (
                    <img
                      src={item.src}
                      alt={item.alt}
                      width={item.width}
                      height={item.height}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="accreditation__text-mark">{item.name}</span>
                  )}
                </span>
                {item.name && <span class="accreditation__name">{item.name}</span>}
              </Fragment>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .accreditations {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .accreditations__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 3vw, 2.5rem) clamp(2rem, 4vw, 4rem);
  }

  .accreditations__intro {
    flex: 1 1 22rem;
    max-width: 36rem;
  }

  /* An h2 for document outline, sized like an h3 for this compact strip. */
  .accreditations__heading {
    margin-bottom: 0.35rem;
    font-size: var(--fs-h3);
  }

  .accreditations__text :global(p) {
    margin: 0;
    font-size: var(--fs-small);
  }

  .accreditations__list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .accreditation,
  .accreditation__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .accreditation__link {
    color: inherit;
    text-decoration: none;
  }

  /* Third-party marks always sit on a white chip; equal heights, natural widths. */
  .accreditation .logo-chip {
    min-width: 7rem;
    min-height: 5.25rem;
    transition: border-color var(--transition);
  }

  .accreditation .logo-chip img {
    max-height: 3.5rem;
    max-width: 9.5rem;
    width: auto;
    height: auto;
  }

  .accreditation__text-mark {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-anchor);
  }

  .accreditation__name {
    font-family: var(--font-heading);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  /* Hover only where there is a link. */
  .accreditation__link:hover .logo-chip {
    border-color: var(--color-teal-dark);
  }

  .accreditation__link:hover .accreditation__name {
    color: var(--color-teal-dark);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (min-width: 1024px) {
    .accreditations__list {
      justify-content: flex-end;
    }
  }
</style>

---
/**
 * Inline stroke icons (Feather-style, 24×24). Usage: <Icon name="leaf" size={24} />
 * Names: leaf, feather, heart, shield, compass, chat, users, user, calendar, book, sun,
 * moon, home, smile, clock, phone, mail, map-pin, arrow-right, check, menu, close,
 * external, video, award, briefcase, life-buoy.
 */
interface Props {
  name: string;
  size?: number | string;
  class?: string;
  title?: string;
  strokeWidth?: number;
}
const { name, size = 24, class: className, title, strokeWidth = 1.75 } = Astro.props;

const icons: Record<string, string> = {

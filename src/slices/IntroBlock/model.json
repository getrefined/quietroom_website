{
  "id": "intro_block",
  "type": "SharedSlice",
  "name": "IntroBlock",
  "description": "Two-column introduction with text, image, optional link and credential chips",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow"
          }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "single": "heading2,em"
          }
        },
        "text": {
          "type": "StructuredText",
          "config": {
            "label": "Text",
            "multi": "paragraph,strong,em,hyperlink,list-item"
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Image",
            "constraint": {},
            "thumbnails": []
          }
        },
        "image_position": {
          "type": "Select",
          "config": {
            "label": "Image position",
            "options": ["right", "left"],
            "default_value": "right"
          }
        },
        "link": {
          "type": "Link",
          "config": {
            "label": "Link",
            "allowText": true
          }
        },
        "credentials": {
          "type": "Group",
          "config": {
            "label": "Credentials",
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Label"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}

{
  "id": "practitioner_list",
  "type": "SharedSlice",
  "name": "PractitionerList",
  "description": "Cards for recommended practitioners with photo, bio and contact details",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow"
          }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "single": "heading2,em"
          }
        },
        "text": {
          "type": "StructuredText",
          "config": {
            "label": "Text",
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "items": {
          "type": "Group",
          "config": {
            "label": "Items",
            "fields": {
              "name": {
                "type": "Text",
                "config": {
                  "label": "Name"
                }
              },
              "role": {
                "type": "Text",
                "config": {
                  "label": "Role"
                }
              },
              "photo": {
                "type": "Image",
                "config": {
                  "label": "Photo",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "bio": {
                "type": "StructuredText",
                "config": {
                  "label": "Bio",
                  "multi": "paragraph,strong,em,hyperlink"
                }
              },
              "email": {
                "type": "Text",
                "config": {
                  "label": "Email"
                }
              },
              "phone": {
                "type": "Text",
                "config": {
                  "label": "Phone"
                }
              },
              "website": {
                "type": "Link",
                "config": {
                  "label": "Website",
                  "allowText": true
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}

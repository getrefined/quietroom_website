{
  "id": "service_cards",
  "type": "SharedSlice",
  "name": "ServiceCards",
  "description": "Grid of service cards with icon, title, text and optional link",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow"
          }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "single": "heading2,em"
          }
        },
        "text": {
          "type": "StructuredText",
          "config": {
            "label": "Text",
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "columns": {
          "type": "Select",
          "config": {
            "label": "Columns",
            "options": ["3", "2"],
            "default_value": "3"
          }
        },
        "items": {
          "type": "Group",
          "config": {
            "label": "Items",
            "fields": {
              "icon": {
                "type": "Select",
                "config": {
                  "label": "Icon",
                  "options": [
                    "leaf",
                    "feather",
                    "heart",
                    "shield",
                    "compass",
                    "chat",
                    "users",
                    "user",
                    "calendar",
                    "book",
                    "sun",
                    "moon",
                    "home",
                    "smile",
                    "clock",
                    "phone",
                    "mail",
                    "map-pin",
                    "arrow-right",
                    "check",
                    "menu",
                    "close",
                    "external",
                    "video",
                    "award",
                    "briefcase",
                    "life-buoy"
                  ],
                  "default_value": "leaf"
                }
              },
              "title": {
                "type": "Text",
                "config": {
                  "label": "Title"
                }
              },
              "text": {
                "type": "StructuredText",
                "config": {
                  "label": "Text",
                  "multi": "paragraph,strong,em,hyperlink"
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link",
                  "allowText": true
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
